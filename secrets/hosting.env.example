# ===================================================================
# HOSTING PLATFORM SECRETS — template
# ===================================================================
# Real values go in secrets/hosting.env.encrypted:
#
#   sops -e secrets/hosting.env.example > secrets/hosting.env.encrypted
#
# Ansible (hosting_docker_host role) decrypts this file onto docker01 at
# /etc/sis-hosting/hosting.env (0600 root). Keys are consumed by the
# nightly backup runner and the watchdog.
#
# Generating a strong restic password:
#   openssl rand -base64 32
# ===================================================================

# --- Restic (tenant backup repo on /srv/backups + B2 offsite) -----------
# Master password for the LOCAL restic repo. Losing it loses every
# tenant backup. Store a copy in the password manager AND a printed
# copy in the safe.
RESTIC_PASSWORD=CHANGE_ME_openssl_rand_base64_32

# --- Backblaze B2 (offsite copy destination) -----------------------------
B2_ENDPOINT_HOST=s3.eu-central-003.backblazeb2.com
B2_BUCKET=HostingTenantsBackup
B2_ACCESS_KEY_ID=CHANGE_ME_application_key_id
B2_SECRET_ACCESS_KEY=CHANGE_ME_application_key

# --- Alerts ---------------------------------------------------------------
# Watchdog + backup failures. Keep the same topic family as SIS.
NTFY_TOPIC=wyattau-infra-0e92568ce5d04343c3b796ed558a04b9
