#!/bin/bash
# ===================================================================
# watchdog.sh — hosting-platform meta-watchdog.
# Managed by Ansible (hosting_docker_host). Edits are overwritten.
#
# Checks, from the tenant host itself (independent of any monitoring
# stack that could itself be down):
#   1. Any tenant container unhealthy/restarting
#   2. Edge proxy (Caddy) alive and serving
#   3. Offsite backup freshness (last success < 25h)
# Alerts to ntfy on failure. Silence is health.
# ===================================================================
set -u

NTFY="{{ hosting_ntfy_url }}"
# Dual-emit target (estate eventbusd): durable, replayable watchdog events
# beside the ntfy push. Publish failure is never fatal to the watchdog.
EVENTBUS="{{ hosting_eventbus_url | default('') }}"
EVENTBUS_TOKEN="{{ hosting_eventbus_token | default('') }}"

emit_event() {
    # emit_event <topic> <payload-json>
    [ -n "$EVENTBUS" ] || return 0
    curl -s --max-time 5 -X POST "$EVENTBUS/publish/$1" \
        -H "Authorization: Bearer $EVENTBUS_TOKEN" \
        -H "Content-Type: application/json" \
        -d "$2" > /dev/null || true
}
TENANT_ROOT="{{ hosting_data_mount }}/tenants"
OFFSITE_LOG="{{ hosting_data_mount }}/backups/.last-offsite-success"
NOW=$(date +%s)
failures=""

# 1. Tenant fleet health
BAD=0
for compose in "$TENANT_ROOT"/*/compose.sh; do
    [ -x "$compose" ] || continue
    # Default `compose ps` output already includes the Status column, so
    # plain grep works here. (--format braces would collide with Jinja.)
    n=$(cd "$(dirname "$compose")" && ./compose.sh ps 2>/dev/null \
        | grep -cE 'unhealthy|Restarting' || true)
    BAD=$((BAD + n))
done
[ "$BAD" -gt 0 ] && failures="$failures\n- TENANTS DEGRADED: $BAD container(s) unhealthy/restarting"

# 2. Edge proxy answers locally
if ! curl -fsS --max-time 8 -o /dev/null http://127.0.0.1:80/ 2>/dev/null; then
    # Port 80 may legitimately refuse plain HTTP if Caddy redirects; test 443 too.
    if ! echo | timeout 8 openssl s_client -connect 127.0.0.1:443 -servername localhost 2>/dev/null | grep -q "BEGIN CERTIFICATE"; then
        failures="$failures\n- EDGE PROXY NOT RESPONDING on 80/443"
    fi
fi

# 3. Offsite backup freshness
AGE=$((NOW - $(cat "$OFFSITE_LOG" 2>/dev/null || echo 0)))
[ "$AGE" -gt 90000 ] && failures="$failures\n- OFFSITE BACKUP STALE: $((AGE / 3600))h since last success"

# 4. Local resource pressure (kernel PSI — research loop iter 16). The
#    TrueNAS node_pressure alerts stay the tuned watch; this is the
#    coarse local guard that still fires if the scrape path is dead.
#    Thresholds sit above the nightly backup window's normal footprint
#    (the sweep yields at CPUWeight/IOWeight=20).
psi_avg60() { # psi_avg60 <cpu|memory|io> <some|full>
    grep -m1 "^$2" "/proc/pressure/$1" 2>/dev/null \
        | grep -o 'avg60=[0-9.]*' | cut -d= -f2 | cut -d. -f1
}
MEM_FULL=$(psi_avg60 memory full); IO_FULL=$(psi_avg60 io full); CPU_SOME=$(psi_avg60 cpu some)
[ "${MEM_FULL:-0}" -ge 10 ] && failures="$failures\n- MEMORY PRESSURE: full=${MEM_FULL}% avg60 (thrashing)"
[ "${IO_FULL:-0}" -ge 40 ] && failures="$failures\n- IO PRESSURE: full=${IO_FULL}% avg60"
[ "${CPU_SOME:-0}" -ge 80 ] && failures="$failures\n- CPU PRESSURE: some=${CPU_SOME}% avg60 (sustained oversubscription)"

if [ -n "$failures" ]; then
    curl -s -H "Title: HOSTING WATCHDOG: degraded" -H "Priority: high" \
        -d "$(echo -e "$failures")" "$NTFY" > /dev/null
    FAILURES_JSON=$(printf '%s' "$failures" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' 2>/dev/null || echo '"{}"')
    emit_event "hosting.watchdog.degraded" "{\"failures\": $FAILURES_JSON, \"at\": \"$(date -Is)\"}"
    echo "ALERT SENT:$failures"
    exit 1
fi

echo "watchdog OK (bad=$BAD offsite_age=${AGE}s psi_mem_full=${MEM_FULL:-0}% io_full=${IO_FULL:-0}% cpu_some=${CPU_SOME:-0}%)"

# Dual-emit: healthy heartbeat to eventbusd (research loop wave 2).
emit_event "hosting.watchdog.healthy" "{\"at\": \"$(date -Is)\"}"
