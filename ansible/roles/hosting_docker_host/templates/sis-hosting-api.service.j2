[Unit]
Description=SIS hosting — control-plane API (hosting-api)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart={{ hosting_opt_dir }}/bin/hosting-api
Environment=TENANT_ROOT={{ hosting_data_mount }}/tenants
Environment=HOSTING_JOBS_DIR={{ hosting_data_mount }}/backups/jobs
Environment=HOSTING_LISTEN=127.0.0.1:8484
Environment=HOSTING_BACKUP_SCRIPT={{ hosting_bin_dir }}/tenant-backup.sh
# Identity loop (round 7/8, iters 59/64): authbox-issued Admin JWTs join
# the legacy break-glass token on /api. Ledger journal persists closed
# metering windows. Both optional — unset keeps prior behavior.
{% if hosting_oidc_issuer is defined and hosting_oidc_issuer %}
Environment=HOSTING_OIDC_ISSUER={{ hosting_oidc_issuer }}
Environment=HOSTING_OIDC_AUDIENCE={{ hosting_oidc_audience | default('hosting-api') }}
{% endif %}
{% if hosting_ledger_db is defined and hosting_ledger_db %}
Environment=HOSTING_LEDGER_DB={{ hosting_ledger_db }}
{% endif %}
{% if hosting_secrets_tpm_creds | bool %}
RuntimeDirectory=sis-hosting
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/systemd-creds decrypt --name=hosting.env {{ hosting_env_dir }}/hosting.env.cred /run/sis-hosting/hosting.env
EnvironmentFile=-/run/sis-hosting/hosting.env
{% else %}
EnvironmentFile={{ hosting_env_dir }}/hosting.env
{% endif %}
# API token is injected via the SOPS environment file (HOSTING_API_TOKEN=...)
Restart=on-failure
RestartSec=5
# Loopback-only listener: the edge proxy is the only public path.
NoNewPrivileges=true
ProtectSystem=strict
{% if hosting_unit_landlock_hardening | bool %}
# Research loop iter 15: kernel Landlock fs-type deny list (systemd 253+).
RestrictFileSystems=~nfs cifs fuse sshfs
{% endif %}
ReadWritePaths={{ hosting_data_mount }} /etc/sis-hosting

[Install]
WantedBy=multi-user.target
