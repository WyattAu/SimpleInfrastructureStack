# Kernel tuning for the tenant Docker host.
# Managed by Ansible (hosting_docker_host).

# Connection handling under fan-out (many small tenant workloads)
net.core.somaxconn = 4096
net.ipv4.tcp_max_syn_backlog = 4096

# TIME_WAIT reuse: tenants open and close many short-lived connections
net.ipv4.tcp_tw_reuse = 1

# Container-scale file descriptor headroom
fs.file-max = 2097152
fs.inotify.max_user_instances = 1024
fs.inotify.max_user_watches = 1048576

# Forwarding required for Docker NAT
net.ipv4.ip_forward = 1

# vm.max_map_count: ElasticSearch/OpenSearch-class tenants need 262144
vm.max_map_count = 262144

# Keep container churn from spamming the kernel console
kernel.printk = 3 4 1 3
