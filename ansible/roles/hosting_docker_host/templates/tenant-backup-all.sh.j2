#!/bin/bash
# ===================================================================
# tenant-backup-all.sh — nightly per-tenant backup sweep.
# Managed by Ansible (hosting_docker_host). Edits are overwritten.
#
# Iterates every provisioned tenant under /srv/tenants and runs
# tenant-backup.sh with the offsite flag. Each tenant is backed up and
# restored independently; one failure must not skip the rest.
# ===================================================================
set -u

source /etc/sis-hosting/env
source /etc/sis-hosting/hosting.env

TENANT_ROOT="{{ hosting_data_mount }}/tenants"
LOCAL_REPO="{{ hosting_backup_local_repo }}"
OFFSITE_LOG="{{ hosting_data_mount }}/backups/.last-offsite-success"
NTFY="{{ hosting_ntfy_url }}"
FAILURES=""

shopt -s nullglob
for tenant_dir in "$TENANT_ROOT"/*/; do
    tenant="$(basename "$tenant_dir")"

    # A directory without provisioned secrets is not a tenant (yet).
    [ -x "$tenant_dir/compose.sh" ] || continue

    echo "[$(date -Is)] backing up tenant: $tenant"
    if ! env \
        TENANT_ROOT="$TENANT_ROOT" \
        BACKUP_BASE_PATH="{{ hosting_data_mount }}/backups" \
        RESTIC_REPOSITORY="$LOCAL_REPO" \
        RESTIC_PASSWORD_FILE="/etc/sis-hosting/restic-password" \
        B2_ENDPOINT="s3:https://${B2_ENDPOINT_HOST}" \
        B2_BUCKET="${B2_BUCKET}" \
        B2_ACCESS_KEY_ID="${B2_ACCESS_KEY_ID}" \
        B2_SECRET_ACCESS_KEY="${B2_SECRET_ACCESS_KEY}" \
        "{{ hosting_bin_dir }}/tenant-backup.sh" "$tenant" --offsite; then
        FAILURES="$FAILURES\n- $tenant"
        echo "[$(date -Is)] BACKUP FAILED: $tenant" >&2
    fi
done

if [ -n "$FAILURES" ]; then
    curl -s -H "Title: HOSTING: tenant backup failures" -H "Priority: high" \
        -d "$(echo -e "Failed tenants:$FAILURES")" "$NTFY" > /dev/null
    exit 1
fi

# --- retention (research iter 4: was opt-in via TENANT_PRUNE and never ran) -
# Enforce the forget policy once a week. Applies to the whole live repo by
# design: one policy, one place. Offsite copies are never pruned here.
if [ "$(date +%u)" = "7" ]; then
    echo "[$(date -Is)] weekly retention pass (keep 7d/5w/12m)"
    if ! env RESTIC_REPOSITORY="$LOCAL_REPO" \
        RESTIC_PASSWORD_FILE="/etc/sis-hosting/restic-password" \
        restic forget --keep-daily 7 --keep-weekly 5 --keep-monthly 12 --prune; then
        curl -s -H "Title: HOSTING: weekly prune FAILED" -H "Priority: high" \
            -d "restic forget/prune failed - repo retention is drifting" "$NTFY" > /dev/null
    fi

    # --- integrity (research iter 4: restic check never ran anywhere) -------
    # Rolling 25% data read each week -> full coverage roughly monthly, per
    # restic's own recommendation for large repos without a full offline read.
    if ! env RESTIC_REPOSITORY="$LOCAL_REPO" \
        RESTIC_PASSWORD_FILE="/etc/sis-hosting/restic-password" \
        restic check --read-data-subset=25%; then
        curl -s -H "Title: HOSTING: restic check FAILED" -H "Priority: high" \
            -d "restic check found repo corruption - RESTORE DRILL NOW" "$NTFY" > /dev/null
    fi
fi

# --- image hygiene (research iter 43) ----------------------------------------
# Renovate bumps tags constantly; every old tag stays on disk and
# /var/lib/docker lives on the SYSTEM disk (100 GiB), not the quota'd
# data disk. Monthly (first Sunday, inside the yielding window): drop
# unused images older than 14 days (the rollback window) and dead
# containers older than 7 days. Volumes are NEVER pruned here - that is
# customer data. The disk watchdog (iter 43) makes slow growth loud
# regardless.
if [ "$(date +%u)" = "7" ] && [ "$(date +%-d)" -le 7 ]; then
    echo "[$(date -Is)] monthly docker hygiene:"
    docker system df || true
    docker image prune -a -f --filter "until=336h" || true
    docker container prune -f --filter "until=168h" >/dev/null || true
fi

# --- restore drill (research iter 26) ----------------------------------------
# An unverified backup is a wish (the DR section says rehearse quarterly;
# nobody schedules it, so the sweep does). First Sunday of each month:
# actually RESTORE one tenant's latest snapshot to a scratch tree and
# prove it came back (compose file present, files exist), then delete the
# scratch. Rotation is deterministic per month (month index % tenant
# count) so every tenant gets a full-restore proof over time. The drill
# runs inside the yielding sweep unit; page on failure with DRILL wording
# - restores are the artifact customers actually pay for.
if [ "$(date +%u)" = "7" ] && [ "$(date +%-d)" -le 7 ]; then
    mapfile -t all_tenants < <(find "$TENANT_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
    drill_candidates=()
    for t in "${all_tenants[@]}"; do
        [ -x "$TENANT_ROOT/$t/compose.sh" ] && drill_candidates+=("$t")
    done
    if [ "${#drill_candidates[@]}" -gt 0 ]; then
        drill_tenant="${drill_candidates[$(( $(date +%-m) % ${#drill_candidates[@]} ))]}"
        drill_dir="{{ hosting_data_mount }}/backups/restore-test/$drill_tenant"
        echo "[$(date -Is)] monthly restore drill: $drill_tenant"
        rm -rf "$drill_dir"
        mkdir -p "$drill_dir"
        drill_start=$(date +%s)
        drill_ok=1
        if ! env RESTIC_REPOSITORY="$LOCAL_REPO" \
            RESTIC_PASSWORD_FILE="/etc/sis-hosting/restic-password" \
            restic restore latest --tag "tenant:$drill_tenant" --target "$drill_dir"; then
            drill_ok=0
            drill_why="restic restore FAILED"
        else
            drill_secs=$(( $(date +%s) - drill_start ))
            total_files=$(find "$drill_dir" -type f 2>/dev/null | wc -l)
            compose_found=$(find "$drill_dir" -maxdepth 4 \( -name 'docker-compose.yml' -o -name 'compose.sh' \) 2>/dev/null | head -1)
            [ "$total_files" -ge 1 ] || { drill_ok=0; drill_why="restore came back EMPTY"; }
            [ -n "$compose_found" ] || { drill_ok=0; drill_why="no compose file in restored tree"; }
        fi
        if [ "$drill_ok" -eq 1 ]; then
            echo "[$(date -Is)] restore drill OK: $drill_tenant (${drill_secs}s, $total_files files restored + verified)"
        else
            curl -s -H "Title: HOSTING: RESTORE DRILL FAILED" -H "Priority: high" \
                -d "tenant:$drill_tenant — $drill_why. The backup cannot be trusted; run the DR drill by hand NOW" "$NTFY" > /dev/null
        fi
        rm -rf "$drill_dir"
    fi
fi

date +%s > "$OFFSITE_LOG"
echo "[$(date -Is)] all tenant backups OK (offsite copy done)"
