# Image versions for the tenant "documents" stack (Paperless-ngx).
# All images are EvergreenImageRegistry builds (hardened, CIS-scanned,
# non-root where the upstream supports it, health-shim instrumented).
#
# renovate: datasource=docker depName=ghcr.io/wyattau/evergreenimageregistry/postgres
POSTGRES_VERSION=17.10
# renovate: datasource=docker depName=ghcr.io/wyattau/evergreenimageregistry/redis
REDIS_VERSION=7.4-alpine
# renovate: datasource=docker depName=ghcr.io/wyattau/evergreenimageregistry/paperless-ngx
PAPERLESS_VERSION=2.20.15
# renovate: datasource=docker depName=ghcr.io/wyattau/evergreenimageregistry/paperless-ngx-gotenberg
GOTENBERG_VERSION=2.14.4
# renovate: datasource=docker depName=ghcr.io/wyattau/evergreenimageregistry/paperless-ngx-tika
TIKA_VERSION=2.14.4
