# Image versions for the tenant "files" stack (Ferro).
#
# NOTE: ferro is our own product, so there is no upstream Renovate datasource.
# Bump FERRO_VERSION deliberately after regression-testing a customer tenant —
# a version bump is a customer-visible change, not a routine dependency bump.
FERRO_VERSION=prod-20260905

# renovate: datasource=docker depName=ghcr.io/wyattau/evergreenimageregistry/postgres
POSTGRES_VERSION=17.10
