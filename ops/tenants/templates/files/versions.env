# Image versions for the tenant "files" stack (Ferro).
#
# NOTE: ferro is our own product, so there is no upstream Renovate datasource.
# Bump FERRO_VERSION deliberately after regression-testing a customer tenant —
# a version bump is a customer-visible change, not a routine dependency bump.
# (iteration 29: prod-20260905 never existed in the registry — pinned from
# imagination. Real published prod tags: prod-20261101, prod-20261105.)
FERRO_VERSION=prod-20261105

# renovate: datasource=docker depName=ghcr.io/wyattau/evergreenimageregistry/postgres
# (iteration 29: this pin named a tag the registry never had — the EIR's
# versioned push had failed silently. postgres:17.10 retro-tagged from the
# signed latest digest and the EIR workflow now fails loudly on a
# versioned-push miss.)
POSTGRES_VERSION=17.10
