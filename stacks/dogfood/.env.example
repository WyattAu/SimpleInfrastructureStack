# Dogfood stack secrets (gitignored .env holds the real values)
DOGFOOD_ADMIN_TOKEN=generate-with-openssl-rand-hex-32
DOGFOOD_BUS_TOKEN=generate-with-openssl-rand-hex-32
AUTHBOX_ISSUER=http://192.168.1.3:9005
AUTHBOX_AUDIENCE=account
# Round 7 iter 59: registry triples (id:secret:role; roles
# viewer|editor|admin). The admin entry consumes AUTHBOX_CLIENT_SECRET.
AUTHBOX_CLIENT_SECRET=generate-with-openssl-rand-hex-32
AUTHBOX_DEFAULT_AUDIENCE=account
