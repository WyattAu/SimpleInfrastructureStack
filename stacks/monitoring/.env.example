# Path: /monitoring/.env
# ===================================================================
# MONITORING STACK ENVIRONMENT
# ===================================================================

# --- Service Versions (Pinned) ---
VICTORIAMETRICS_VERSION=v1.143.0
VMALERT_VERSION=v1.143.0
VICTORIALOGS_VERSION=v1.50.0
GRAFANA_VERSION=12.2.9.9
PROMTAIL_VERSION=3.6.11
ALERTMANAGER_VERSION=0.32.1
TEMPO_VERSION=2.10.5
KUMA_VERSION=2.3.2
CADVISOR_VERSION=v0.52.1
NODE_EXPORTER_VERSION=v1.9.1

# --- Subdomains ---
PROMETHEUS_SUBDOMAIN="prometheus"
GRAFANA_SUBDOMAIN="grafana"
KUMA_SUBDOMAIN="kuma"

# --- Grafana Credentials ---
# Admin password for the local Grafana user account.
# Primary authentication is handled via Keycloak OIDC.
GRAFANA_ADMIN_PASSWORD="GENERATE_THIS"

# --- Grafana Keycloak OIDC Client Credentials ---
GRAFANA_OIDC_CLIENT_ID="grafana"
GRAFANA_OIDC_CLIENT_SECRET="GET_FROM_KEYCLOAK"

# --- VictoriaLogs Authentication ---
# Credentials for Promtail to push logs to VictoriaLogs.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
VICTORIALOGS_USERNAME="victorialogs"
VICTORIALOGS_PASSWORD="GENERATE_THIS"

# --- Alertmanager ntfy Notifications ---
# Full ntfy webhook URLs (including topic with access key).
# Create topics at https://ntfy.sh — each topic gets a unique access key.
NTFY_TOPIC_CRITICAL_URL="https://ntfy.sh/wyattau-infra-TOPIC_KEY-critical"
NTFY_TOPIC_INFO_URL="https://ntfy.sh/wyattau-infra-TOPIC_KEY"
