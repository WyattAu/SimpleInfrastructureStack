# ===================================================================
# PROXY STACK ENVIRONMENT
# ===================================================================

# --- Service Versions (Pinned) ---
TRAEFIK_VERSION=v3.7.3
CF_DDNS_VERSION=latest
OAUTH2_PROXY_VERSION=v7.15.3
NGINX_VERSION=1.25.4-alpine

# --- Forward Auth Secret ---
OAUTH2_PROXY_COOKIE_SECRET="GenerateARandom32CharacterSecret"

# --- Keycloak Client Credentials for Forward Auth ---
OAUTH2_PROXY_CLIENT_ID="traefik-forward-auth"
OAUTH2_PROXY_CLIENT_SECRET="GenerateAStrongSecretForForwardAuthInKeycloak"
