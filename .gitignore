# Secrets (NEVER commit these)
*.env
!*.env.example
!*.env.encrypted
!versions.env
*.pem
*.key
*.crt

# Cloudflare tunnel credentials (contains tunnel secret)
stacks/tunnel/credentials.json

# Decrypted secrets temp directory (written at deploy time, cleaned up after)
.secrets.tmp/

# SOPS metadata (only contains public keys — safe to commit)
# .sops.yaml is NOT ignored; it contains only age public key references

# Age keys
*.age
age-keygen*

# Ansible
*.retry
*.log

# Webhook (generated from template at runtime)
stacks/webhook/hooks.yaml

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo
*~

# Terraform
*.tfstate
*.tfstate.*
.terraform/
# Note: .terraform.lock.hcl is tracked (provider pinning)

# Temporary files
/tmp/
*.tmp
.forgejo_token
", d[k])\n"
stacks/webhook/ssh/
stacks/webhook/.env
stacks/blocmarket/
tf_import.sh
tunnel/
stacks/headscale/config/noise.private.key
stacks/monitoring/alertmanager/alertmanager.yml

# Forgejo token (rotate via web UI, store in secrets/)
.forgejo_token

